#!/bin/bash
set -e

if [ $# -eq 0 ]; then
    echo "Usage: mkpkg directory_name"
else
    DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/$1"
    BUILD_DIR=$(mktemp -d)
    trap 'rm -rf "$BUILD_DIR"' EXIT
    PLUGIN=$(basename "$DIR")
    ARCHIVE="$(dirname "$(dirname "$DIR")")/pkg"
    PLG_FILE="$(dirname "$(dirname "$DIR")")/${PLUGIN}.plg"
    grep -qE '<!ENTITY[[:space:]]+sha256[[:space:]]+"[^"]*">' "$PLG_FILE"
    VERSION=$(date +"%Y.%m.%d")
    ARCH="-x86_64"
    PACKAGE="${ARCHIVE}/${PLUGIN}-${VERSION}${ARCH}.txz"
    SHA256="${ARCHIVE}/${PLUGIN}-${VERSION}${ARCH}.sha256"

    for x in '' a b c d e d f g h ; do
        PKG="${ARCHIVE}/${PLUGIN}-${VERSION}${x}${ARCH}.txz"
        if [[ ! -f $PKG ]]; then
          PACKAGE=$PKG
          VERSION="${VERSION}${x}"
          SHA256="${ARCHIVE}/${PLUGIN}-${VERSION}${ARCH}.sha256"
          break
        fi
    done

    cd "$DIR"
    cp --recursive --dereference . "${BUILD_DIR}/"
    cd "$BUILD_DIR/"
    makepkg -l y -c y "${PACKAGE}"
    cd "$ARCHIVE/"
    sha256sum "$(basename "$PACKAGE")" > "$SHA256"

    # Publish manifest metadata only after the package passes verification.
    if ! sha256sum --check --status "$SHA256"; then
      echo "Checksum mismatched.";
      rm "$SHA256" "$PACKAGE"
      exit 1
    fi
    sum=$(cut -d ' ' -f 1 "$SHA256")
    [[ "$sum" =~ ^[[:xdigit:]]{64}$ ]]
    sed -i -e "s#\(ENTITY\s*version[^\"]*\).*#\1\"${VERSION}\">#" \
           -e "s#\(ENTITY\s*sha256[^\"]*\).*#\1\"${sum}\">#" "$PLG_FILE"
    sed -i "/##&name/a\###${VERSION}" "$PLG_FILE"
    echo "SHA256 checksum matched and plugin manifest updated."
fi
